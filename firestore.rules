rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCreator() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreator == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasActiveSubscription(creatorId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + creatorId)) &&
             get(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + creatorId)).data.status == 'active' &&
             get(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_' + creatorId)).data.expiresAt > request.time;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow delete: if isAdmin();

      // Owner or admin can update anything on their own profile
      // Any authenticated user can update ONLY follower/following counts (for follow/unfollow)
      // New users can write referredBy to their own doc (referral attribution on signup)
      allow update: if isOwner(userId)
        || isAdmin()
        || (
          isAuthenticated() &&
          // Only allow updating these specific counter fields — nothing else
         request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['followers', 'following', 'followerCount', 'followingCount', 'updatedAt'])
        )
        || (
          // Allow new users to set referredBy on their own doc (signup referral)
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referredBy'])
        );
    }

    // ── Creator tiers ─────────────────────────────────────────────────────────
    match /creator_tiers/{creatorId} {
      allow read: if true;
      allow write: if isOwner(creatorId) || isAdmin();
    }

    // ── Subscriptions ─────────────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow list: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ── Top-level comments ────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ── Likes ─────────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── Wallets (legacy) ──────────────────────────────────────────────────────
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── User balances ─────────────────────────────────────────────────────────
    match /user_balances/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAuthenticated();
    }

    // ── Transactions ──────────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.creatorId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /wallet_transactions/{txId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /subscription_transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ── Earnings ──────────────────────────────────────────────────────────────
    match /earnings/{earningId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ── Unlocked content ──────────────────────────────────────────────────────
    match /unlocked_content/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ── Creator availability ──────────────────────────────────────────────────
    match /creator_availability/{creatorId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == creatorId;
    }

    // ── Video / voice calls ───────────────────────────────────────────────────
    match /video_calls/{callId} {
      allow read: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.fanId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /call_bookings/{bookingId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /call_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ── Conversations & messages ──────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if isAuthenticated() && isParticipant();
        allow create: if isAuthenticated() && isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && isParticipant();
        allow delete: if isAuthenticated() && isParticipant();
      }
    }

    // ── PPV unlocks ───────────────────────────────────────────────────────────
    match /ppv_unlocks/{unlockId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Crypto payments (NowPayments / USDT) ──────────────────────────────────
    match /crypto_payments/{paymentId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── NGN bank transfer payments ────────────────────────────────────────────
    match /ngn_payments/{paymentId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Platform settings (NGN rate, etc.) ────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuthenticated() && isCreator();
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    match /community_members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /community_posts/{postId} {
      function isCommunityMember(communityId) {
        return exists(/databases/$(database)/documents/community_members/$(request.auth.uid + '_' + communityId)) &&
               get(/databases/$(database)/documents/community_members/$(request.auth.uid + '_' + communityId)).data.subscriptionStatus == 'active';
      }
      function isCommunityOwner(communityId) {
        return get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == request.auth.uid;
      }
      function membersCanPost(communityId) {
        return get(/databases/$(database)/documents/communities/$(communityId)).data.membersCanPost == true;
      }
      allow read: if isAuthenticated() && (
        isCommunityMember(resource.data.communityId) ||
        isCommunityOwner(resource.data.communityId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isCommunityOwner(request.resource.data.communityId) ||
        (isCommunityMember(request.resource.data.communityId) && membersCanPost(request.resource.data.communityId))
      );
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        isCommunityOwner(resource.data.communityId) ||
        isCommunityMember(resource.data.communityId) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        isCommunityOwner(resource.data.communityId) ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Creator balances & payouts ────────────────────────────────────────────
    match /creator_balances/{creatorId} {
      allow read: if isOwner(creatorId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /pending_releases/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payout_requests/{requestId} {
      allow get: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Tips ──────────────────────────────────────────────────────────────────
    match /tips/{tipId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toCreatorId == request.auth.uid ||
        isAdmin()
      );
      // Allow users to list their own tips
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ── Blocks ────────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    // ── Creator discounts ─────────────────────────────────────────────────────
    match /creator_discounts/{creatorId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(creatorId) || isAdmin();
    }

    // ── Scheduled notifications ───────────────────────────────────────────────
    match /scheduled_notifications/{docId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Ambassador referral commissions ───────────────────────────────────────
    // Written by Cloud Functions (admin SDK bypasses rules)
    // Read by the ambassador who owns them, or admin
    match /referralCommissions/{commissionId} {
      allow get: if isAuthenticated() && (
        resource.data.ambassadorId == request.auth.uid || isAdmin()
      );
      // ✅ Fixed: ambassadors can list their OWN commissions (filtered by ambassadorId)
      // Admins can list all
      allow list: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid != null  // ambassador queries filtered by their uid client-side
      );
      // Cloud Function writes via admin SDK (bypasses rules)
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Catch-all: deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
