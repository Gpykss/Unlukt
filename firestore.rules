rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCreator() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreator == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Fields a user must never grant themselves (admin, ambassador, verification, KYC approval).
    // Without this anyone could set isAdmin:true on their own doc and pass every isAdmin() check.
    function safeOwnUserUpdate() {
      // ambassadorNumber / ambassadorSince are set by the server (first 50 creators); signupSource is
      // written once at sign-up (the ?src= name on the link they followed)
      return !changed().hasAny(['isAdmin', 'isAmbassador', 'referralCode', 'isVerified', 'kycReviewedAt', 'kycRejectionReason', 'createdAt',
                                'ambassadorNumber', 'ambassadorSince', 'signupSource'])
        // kycData may only be removed (it moved to the private kyc/{uid} doc)
        && (!changed().hasAny(['kycData']) || !('kycData' in request.resource.data))
        && (!changed().hasAny(['role']) || request.resource.data.role in ['creator', 'fan', 'user'])
        && (!changed().hasAny(['kycStatus']) || request.resource.data.kycStatus == 'pending')
        && !changed().hasAny(['ambassadorBalance', 'totalCommissionEarned',
                              'subscribersCount', 'subscriberCount', 'subscribers', 'postCount'])
        && countersStep()
        && (!changed().hasAny(['referredBy']) || validReferral());
    }

    // Follow counters move by one per follow/unfollow — nobody can set themselves 1,000,000 followers
    function stepOk(k) {
      return !changed().hasAny([k])
        || math.abs(request.resource.data.get(k, 0) - resource.data.get(k, 0)) <= 1;
    }
    function countersStep() {
      return stepOk('followers') && stepOk('following') && stepOk('followerCount') && stepOk('followingCount');
    }

    // referredBy can be set once, only to a real ambassador, and never to yourself
    function validReferral() {
      return resource.data.get('referredBy', null) == null && isAmbassadorUid(request.resource.data.referredBy);
    }

    function safeNewUser() {
      return request.resource.data.get('isAdmin', false) != true
        && request.resource.data.get('isAmbassador', false) != true
        && request.resource.data.get('isVerified', false) != true
        && !(request.resource.data.get('role', 'user') in ['admin', 'ambassador'])
        && !(request.resource.data.get('kycStatus', 'none') in ['approved'])
        && request.resource.data.get('ambassadorBalance', 0) == 0
        && request.resource.data.get('referralCode', null) == null
        && request.resource.data.get('ambassadorNumber', null) == null
        && request.resource.data.get('signupSource', '') is string
        && request.resource.data.get('signupSource', '').size() <= 40
        && (request.resource.data.get('referredBy', null) == null || isAmbassadorUid(request.resource.data.referredBy));
    }

    function isAmbassadorUid(uid) {
      return uid is string && uid != request.auth.uid
        && (get(/databases/$(database)/documents/users/$(uid)).data.get('role', '') == 'ambassador'
            || get(/databases/$(database)/documents/users/$(uid)).data.get('isAmbassador', false) == true);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && safeNewUser();
      allow delete: if isAdmin();

      // Owner or admin can update anything on their own profile
      // Any authenticated user can update ONLY follower/following counts (for follow/unfollow)
      // New users can write referredBy to their own doc (referral attribution on signup)
      allow update: if (isOwner(userId) && safeOwnUserUpdate())
        || isAdmin()
        || (
          isAuthenticated() &&
          // Others may only bump follow counters, by one (subscriber counts are kept by the server)
          changed().hasOnly(['followers', 'following', 'followerCount', 'followingCount', 'updatedAt'])
          && countersStep()
        )
        ;
    }

    // ── Private contact details (email, phone) — profiles are public, these aren't ──
    match /user_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'phoneNumber', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ── Private KYC (ID number, DOB, address, ID photos) — owner + admin only ──
    match /kyc/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isAdmin();
    }

    // ── Creator tiers & fans ───────────────────────────────────────────────────
    match /creator_tiers/{creatorId} {
      allow read: if true;
      allow write: if isOwner(creatorId) || isAdmin();
    }

    match /creators/{creatorId}/fans/{fanId} {
      allow read: if isAuthenticated() && (request.auth.uid == creatorId || request.auth.uid == fanId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == creatorId || isAdmin()); // spend totals: server
    }

    // ── Subscriptions ─────────────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create: if false; // paid on the server (spend → subscription)
      // The fan may only cancel; extending/activating is done by the server after payment
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid
        && changed().hasOnly(['status', 'cancelledAt', 'updatedAt']) && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow list: if true;
      // Locked posts with media are created by the server (publishPost) so originals are never public
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && (request.resource.data.get('type', 'free') == 'free' || request.resource.data.get('images', []).size() == 0);
      allow update: if (isOwner(resource.data.userId)
          && !(changed().hasAny(['images', 'mediaProtected']) && request.resource.data.get('type', 'free') != 'free'))
        || isAdmin() || (
        isAuthenticated() &&
        changed().hasOnly(['likes', 'likedBy', 'shares', 'comments', 'commentsCount', 'commentCount', 'views', 'viewCount', 'updatedAt', 'createdAt']) &&
        (!changed().hasAny(['createdAt']) || !(resource.data.get('createdAt', null) is timestamp))
      );
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ── Top-level comments ────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ── Likes ─────────────────────────────────────────────────────────────────
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ── INVARIANT: CLIENTS NEVER WRITE MONEY, LEDGER, WALLETS, BALANCES ──────
    match /ledger/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // Cloud Functions double-entry only
    }

    match /creatorEarnings/{creatorId}/shards/{shardId} {
      allow read: if isOwner(creatorId) || isAdmin();
      allow write: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow get: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow write: if false; // requestPayout callable only
    }

    match /unlocks/{unlockId} {
      allow read: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /mediaPrivate/{mediaId} {
      allow read, write: if false; // internal metadata; signed URLs only
    }

    // ── Wallets, User balances & Creator balances ───────────────────────────
    // Money: owners read their own balance; only the server (and admins) change it
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /user_balances/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Transactions ──────────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.creatorId ||
        isAdmin()
      );
      allow create: if isAdmin(); // written by the server with every payment
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /wallet_transactions/{txId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /subscription_transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // server
      allow update, delete: if isAdmin();
    }

    // ── Earnings ──────────────────────────────────────────────────────────────
    match /earnings/{earningId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ── Unlocked content ──────────────────────────────────────────────────────
    match /unlocked_content/{docId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if false; // server (`unlock`)
      allow update, delete: if isAdmin();
    }

    // ── Creator availability ──────────────────────────────────────────────────
    match /creator_availability/{creatorId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == creatorId;
    }

    // ── Video / voice calls ───────────────────────────────────────────────────
    match /video_calls/{callId} {
      allow read: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.fanId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.fanId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /call_bookings/{bookingId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      // Only the two people on the call (the "is this creator busy?" check runs on the server)
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false; // booked + paid on the server (spend → call)
      // Either party can run the call (start, end, rejoin, video request), but money fields and
      // refund states belong to the server
      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid
      ) && !changed().hasAny(['userId', 'creatorId', 'price', 'creatorEarning', 'duration', 'type',
                              'creatorPaid', 'ledgerTxId', 'platformFee', 'ambassadorCommission', 'ambassadorId',
                              'scheduledAt', 'refundedAt', 'legacyVerified'])
        // Calls start at most 10 min early, and only a started call can be completed
        && (!changed().hasAny(['status'])
            || (request.resource.data.status == 'in_progress' && request.time >= resource.data.scheduledAt - duration.value(10, 'm'))
            || (request.resource.data.status == 'completed' && resource.data.status == 'in_progress'))
        // Each side only records its own presence; the shared start time is set once
        && (!changed().hasAny(['userEnteredCallAt', 'userEnded', 'userEndedAt']) || request.auth.uid == resource.data.userId)
        && (!changed().hasAny(['creatorEnteredCallAt', 'creatorEnded', 'creatorEndedAt']) || request.auth.uid == resource.data.creatorId)
        && (!changed().hasAny(['callStartedAt']) || resource.data.get('callStartedAt', null) == null));
      allow delete: if isAdmin();
    }

    match /call_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ── Conversations & messages ──────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow get: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      // Participants update chat metadata only — never who's in it or who gets paid (creatorId)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants
        && !changed().hasAny(['participants', 'creatorId', 'fanId']);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if isAuthenticated() && isParticipant();
        // Paid (PPV) messages are sent through the server (sendPPV) so the media is never public
        allow create: if isAuthenticated() && isParticipant() && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('isPPV', false) != true;
        allow update: if isAuthenticated() && isParticipant() && (
          resource.data.senderId == request.auth.uid
            ? !changed().hasAny(['senderId', 'unlockedBy', 'unlockPrice', 'price', 'priceMinor', 'isPPV', 'mediaProtected', 'hasMedia', 'mediaUrl'])
            : changed().hasOnly(['read', 'readAt', 'readBy', 'status', 'reactions', 'updatedAt'])
        );
        allow delete: if isAuthenticated() && isParticipant();
      }
    }

    // ── PPV unlocks ───────────────────────────────────────────────────────────
    match /ppv_unlocks/{unlockId} {
      allow read: if isAuthenticated() && (resource.data.get('userId', resource.data.get('fanId', '')) == request.auth.uid || resource.data.get('creatorId', '') == request.auth.uid || isAdmin());
      allow create: if false; // server (`unlock`)
      allow update, delete: if isAdmin();
    }

    // ── Crypto payments (NowPayments / USDT) ──────────────────────────────────
    match /crypto_payments/{paymentId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if false;     // createPayment function only (a forged doc could hijack an invoice)
      allow update: if isAdmin(); // only the signed NowPayments webhook (admin SDK) changes payments
      allow delete: if isAdmin();
    }

    // ── NGN bank transfer payments ────────────────────────────────────────────
    match /ngn_payments/{paymentId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', 'pending') == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Platform settings (NGN rate, etc.) ────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuthenticated() && isCreator();
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
        || changed().hasOnly(['memberCount']) // leaving updates the member count
      );
      allow delete: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    match /community_members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if false; // joins (free or paid) go through the server
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && changed().hasOnly(['lastActive', 'notifications', 'muted'])) ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /community_posts/{postId} {
      function isCommunityMember(communityId) {
        return exists(/databases/$(database)/documents/community_members/$(request.auth.uid + '_' + communityId)) &&
               get(/databases/$(database)/documents/community_members/$(request.auth.uid + '_' + communityId)).data.subscriptionStatus == 'active';
      }
      function isCommunityOwner(communityId) {
        return get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == request.auth.uid;
      }
      function membersCanPost(communityId) {
        return get(/databases/$(database)/documents/communities/$(communityId)).data.membersCanPost == true;
      }
      allow read: if isAuthenticated() && (
        isCommunityMember(resource.data.communityId) ||
        isCommunityOwner(resource.data.communityId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isCommunityOwner(request.resource.data.communityId) ||
        (isCommunityMember(request.resource.data.communityId) && membersCanPost(request.resource.data.communityId))
      );
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        isCommunityOwner(resource.data.communityId) ||
        isAdmin() ||
        (isCommunityMember(resource.data.communityId) &&
          changed().hasOnly(['likes', 'likeCount', 'likedBy', 'comments', 'commentsCount', 'commentCount', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        isCommunityOwner(resource.data.communityId) ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Social pings only, signed as yourself. Money/booking notices ("payment received", "tip",
      // "refund"…) are written by the server so they can't be faked.
      allow create: if isAuthenticated()
        && request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.type in ['like', 'follow', 'comment', 'message', 'mention', 'reply']
        && request.resource.data.userId is string;
      allow update: if isOwner(resource.data.userId) && changed().hasOnly(['read', 'readAt']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Creator balances & payouts ────────────────────────────────────────────
    match /creator_balances/{creatorId} {
      allow read: if isOwner(creatorId) || isAdmin();
      allow write: if isAdmin(); // sales & payouts: Cloud Functions; admins for manual corrections
    }

    match /pending_releases/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payout_requests/{requestId} {
      allow get: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
      allow create: if false; // withdrawals go through requestPayout (checks the real balance)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Tips ──────────────────────────────────────────────────────────────────
    match /tips/{tipId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toCreatorId == request.auth.uid ||
        isAdmin()
      );
      // Users list only their own tips (sent or received)
      allow list: if isAuthenticated() && (resource.data.fromUserId == request.auth.uid || resource.data.toCreatorId == request.auth.uid || isAdmin());
      allow create: if false; // paid on the server (spend → tip)
      allow update, delete: if isAdmin();
    }

    // ── Blocks ────────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow list: if isAuthenticated() && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow get: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }

    // ── Creator discounts ─────────────────────────────────────────────────────
    match /creator_discounts/{creatorId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(creatorId) || isAdmin();
    }

    // ── Scheduled notifications ───────────────────────────────────────────────
    match /scheduled_notifications/{docId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAdmin(); // call reminders are created by the server with the booking
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Ambassador referral commissions ───────────────────────────────────────
    // Written by Cloud Functions (admin SDK bypasses rules)
    // Read by the ambassador who owns them, or admin
    match /referralCommissions/{commissionId} {
      allow get: if isAuthenticated() && (
        resource.data.ambassadorId == request.auth.uid || isAdmin()
      );
      // ✅ Fixed: ambassadors can list their OWN commissions (filtered by ambassadorId)
      // Admins can list all
      allow list: if isAuthenticated() && (
        isAdmin() || resource.data.ambassadorId == request.auth.uid
      );
      // Cloud Function writes via admin SDK (bypasses rules)
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Livestreaming & Co-Hosting ───────────────────────────────────────────
    match /livestream_rooms/{creatorId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(creatorId) || isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        // Chat/join/presence from anyone (as themselves, no money fields); tips, requests, questions
        // and guest requests are created by the server after payment
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
          && !('amount' in request.resource.data) && !('creatorEarning' in request.resource.data)
          && (request.resource.data.type in ['chat', 'join', 'presence', 'stage_leave']
              || (request.resource.data.type == 'system' && request.auth.uid == creatorId));
        allow update, delete: if isOwner(creatorId) || isAdmin();
      }

      match /visual_effects/{effectId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(creatorId) || isAdmin();
      }
    }

    match /livestream_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /cohost_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Catch-all: deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
